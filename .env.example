# Contoh konfigurasi. Salin menjadi .env, lalu isi nilai asli di mesin lokal.
# Jangan pernah commit .env atau menaruh nilai asli di file ini.

# Koneksi aplikasi: gunakan peran maoelana, bukan postgres.
DATABASE_URL=postgresql://maoelana:CHANGE_ME@127.0.0.1:5432/lapor_aman
DATABASE_SSL=false

# Dipakai untuk menentukan cookie Secure. Gunakan https:// saat hosting.
PUBLIC_BASE_URL=http://localhost:5173

# Hanya untuk bootstrap pemilik database. Jangan dipakai oleh aplikasi.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Kunci terpisah. Buat 32 byte acak lalu encode Base64.
# Jangan ganti kunci setelah ada data; data lama tidak dapat dibaca.
REPORT_DATA_KEY=GENERATE_A_32_BYTE_BASE64_KEY
NIK_DATA_KEY=GENERATE_A_DIFFERENT_32_BYTE_BASE64_KEY

# NVIDIA Nemotron untuk menjawab pesan dan memilih satu topik pelengkap.
AI_ENABLED=true
NVIDIA_API_KEY=SET_YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Akun staff lokal. Ganti sebelum presentasi.
DEMO_STAFF_PETUGAS_PASSWORD=CHANGE_ME_PETUGAS
DEMO_STAFF_BIDAN_PASSWORD=CHANGE_ME_BIDAN
DEMO_STAFF_ADMIN_PASSWORD=CHANGE_ME_ADMIN

# outbox = tidak mengirim WhatsApp. meta/twilio = kirim sungguhan bila kredensial lengkap.
WHATSAPP_PROVIDER=outbox
WHATSAPP_RECIPIENT_NUMBER=
PIC_WHATSAPP_NUMBER=

# Meta Cloud API
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=id
# Hanya nilai generik; jangan pernah memasukkan nama, cerita, NIK, atau kontak.
META_TEMPLATE_VARIABLES=[]

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Alias lama untuk kredensial Meta/Twilio. Kosongkan jika memakai nama di atas.
WHATSAPP_TOKEN=
WHATSAPP_SENDER=
