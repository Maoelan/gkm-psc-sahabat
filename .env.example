# Copy to .env. Never commit real credentials or encryption keys.
# Run npm run convex:dev in a separate terminal for a local Convex deployment.
# Use its deployment URL here; cloud deployments use HTTPS.
CONVEX_URL=http://127.0.0.1:3210

# Generate at least 32 random bytes, encoded as Base64URL.
# Set the same APPLICATION_SERVER_KEY in Convex using `npx convex env set`.
# Keep this key server-only; browsers call SvelteKit, not Convex directly.
APPLICATION_SERVER_KEY=GENERATE_A_32_BYTE_BASE64URL_SERVER_KEY

# Local canonical origin. Vercel previews derive their origin from VERCEL_URL.
# For a stable HTTPS evaluation URL, configure this before building.
PUBLIC_BASE_URL=http://localhost:5173

# Generate two independent 32-byte Base64 encryption keys.
# Keep them stable for each environment and separate from other deployments.
REPORT_DATA_KEY=GENERATE_A_32_BYTE_BASE64_KEY
NIK_DATA_KEY=GENERATE_A_DIFFERENT_32_BYTE_BASE64_KEY

# Optional NVIDIA integration. Fallback guidance works without provider calls.
AI_ENABLED=false
NVIDIA_API_KEY=SET_YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Unique passwords of at least 14 characters. Used only by npm run db:seed.
DEMO_STAFF_PETUGAS_PASSWORD=CHANGE_ME_PETUGAS
DEMO_STAFF_BIDAN_PASSWORD=CHANGE_ME_BIDAN
DEMO_STAFF_ADMIN_PASSWORD=CHANGE_ME_ADMIN

# Evaluation builds only store generic notification events; no messages are sent.
WHATSAPP_PROVIDER=outbox

# Deployment credentials belong in the appropriate CLI/CI secret store.
# Never use a PUBLIC_ prefix for CONVEX_DEPLOY_KEY or VERCEL_TOKEN.
